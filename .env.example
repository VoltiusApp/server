# ============================================================================
# Voltius server — self-hosting configuration
# ----------------------------------------------------------------------------
# Only JWT_SECRET is strictly required for a self-hosted setup.
# Everything else is optional — defaults are sensible.
# ============================================================================

# Required ---------------------------------------------------------------
JWT_SECRET=                          # generate with: openssl rand -hex 32

# Optional: override the bundled Postgres connection (compose default works)
# DATABASE_URL=postgres://voltius:voltius@db/voltius

# Optional: which host port to expose (default 14372)
# HOST_PORT=14372

# Optional: bundled postgres image tag (default 16-alpine). A major-version
# change does not upgrade an existing data volume; Postgres refuses to start.
# POSTGRES_IMAGE_TAG=16-alpine


# Email (optional, recommended) ------------------------------------------
# Without this, email verification + team invitations silently no-op.
# Accounts still work; users just don't receive mail.
# RESEND_API_KEY=re_...              # https://resend.com/api-keys
#
# Set these too if you set RESEND_API_KEY. Resend only sends from a domain
# you have verified, and the link defaults point at the hosted service.
# RESEND_FROM=Voltius <noreply@voltius.example.com>
# VOLTIUS_APP_URL=https://voltius.example.com      # links in verification/invite emails
# VOLTIUS_MARKETING_URL=https://voltius.example.com  # email footer link
# RESEND_LOGO_URL=https://voltius.example.com/logo.png
#
# Signing secret of a Resend webhook pointed at https://<your-host>/v1/webhooks/resend
# with the email.bounced and email.suppressed events. Lets the app tell a user
# their address is undeliverable instead of resending into a suppression list.
# RESEND_WEBHOOK_SECRET=whsec_...


# CORS + reverse proxy (only matters for public deployments) -------------
# CORS_ORIGINS=https://voltius.example.com,tauri://localhost
#
# Addresses or CIDR ranges of reverse proxies whose X-Forwarded-For may be
# trusted. Leave unset and every request is keyed on the peer address instead:
# behind a proxy that means one shared rate-limit bucket for all your users.
# Use the proxy's address as the server sees it — for a proxy in a container,
# that is its container address, so give the network's range rather than a
# single address that changes on every recreate.
#   TRUSTED_PROXIES=172.22.0.0/16     # e.g. a cloudflared container network
#   TRUSTED_PROXIES=127.0.0.1         # a proxy on the host, server on the host
# TRUSTED_PROXY_IP is the older single-address name and still works.


# Feature switches (both default to true) ---------------------------------
# REGISTRATION_ENABLED=true          # false: POST /v1/auth/register refuses new accounts; existing ones keep working
# TEAM_INVITES_ENABLED=true          # false: no new team invitations or join links; pending ones stay usable

# Rate-limit tunables (defaults are fine) --------------------------------
# AUTH_RATE_LIMIT=10                 # login/refresh/challenge per minute per IP
# SYNC_RATE_LIMIT=10000              # authenticated API requests per hour per user
# REGISTER_RATE_LIMIT=20             # account registrations per day per IP
# INVITE_RATE_LIMIT=20               # team invite emails per hour per user
# WAITLIST_RATE_LIMIT=10             # mobile waitlist submissions per hour per IP
# USER_SEARCH_RATE_LIMIT=60          # user directory searches per minute per user
# STRANGER_KNOCK_RATE_LIMIT=20       # terminal-share invites to non-teammates per hour per sender
# RENDEZVOUS_RATE_LIMIT=120          # device rendezvous creations and relay credential requests per hour per user
# RENDEZVOUS_LIST_RATE_LIMIT=600     # pending-rendezvous recovery polls per hour per user


# Sync storage (optional) -------------------------------------------------
# Days to keep a sync blob after a newer one from the same account
# supersedes it. The latest blob is never deleted.
# SYNC_BLOB_RETENTION_DAYS=90


# Two-factor authentication (optional) ------------------------------------
# Encrypts the authenticator seeds of accounts that turn on two-factor
# sign-in. Unset, the server does not offer it and clients hide the option.
# Generate with: openssl rand -base64 32
#
# Back this key up with JWT_SECRET and never change it. Without it the
# server can no longer check anyone's codes: enrolled accounts are refused,
# not let through, until they use a recovery code or an admin clears their
# two-factor from the dashboard.
# TOTP_ENC_KEY=
#
# Passkeys as a second factor. Set this to the domain the web portal is
# served on, or a parent of it: with VOLTIUS_APP_URL=https://app.example.com
# either app.example.com or example.com works. Unset, the server offers no
# passkeys. The portal must be reachable over HTTPS at VOLTIUS_APP_URL, since
# that is where the browser creates and uses them.
#
# Passkeys are bound to this value for good: changing it later makes every
# registered passkey unusable, and their owners fall back to an authenticator
# code or a recovery code.
# WEBAUTHN_RP_ID=


# Account deletion (optional) ---------------------------------------------
# Days an admin soft-deleted account stays restorable. After that the daily
# purge hard-deletes it and its email can be registered again. An account
# still referenced elsewhere (team owner, shared-object author) is kept but
# its email is released, and it can no longer be restored.
# USER_PURGE_GRACE_DAYS=30


# Admin dashboard (optional) ---------------------------------------------
# Only set this if you also run the separate admin-dashboard container.
# Generate the same way as JWT_SECRET.
# ADMIN_SECRET=


# Team vault object write compatibility gate (optional) -------------------
# Minimum client version allowed to WRITE team vault objects, e.g. 0.33.0.
# Unset disables the check (default). Clients below the floor get
# 426 Upgrade Required; reads are never gated. Set this only once your
# users have updated — older clients cannot write to team vaults at all
# while it is set.
# TEAM_OBJECTS_MIN_CLIENT_VERSION=


# Second instances (leave unset) -----------------------------------------
# A second server on the same database refuses to start: sync events,
# terminal sessions, rate limits and presence are per-process, so two
# instances disagree without erroring. See CLAUDE.md before setting this.
# ALLOW_MULTIPLE_INSTANCES=true


# Device file transfer over the internet (Pro) ---------------------------
# DEVICE_INTERNET_FILES=true         # false closes the routes and revokes live relay credentials
# CF_ACCOUNT_ID=                     # Cloudflare account for the TURN relay; all four CF_* vars
# CF_TURN_KEY_ID=                    #   must be set or relay credentials answer RELAY_UNAVAILABLE
# CF_TURN_KEY_TOKEN=                 # TURN key API token (mints and revokes credentials)
# CF_ANALYTICS_TOKEN=                # read-only Account Analytics token (usage guard)
# RELAY_MONTHLY_BUDGET_GB=800        # relay stops account-wide at this egress over a rolling 31 days
