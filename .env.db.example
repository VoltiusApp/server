# Environment for compose.db.yml. Copy to .env.db and fill in.
#   docker compose -f compose.db.yml --env-file .env.db up -d

POSTGRES_USER=voltius
POSTGRES_PASSWORD=
POSTGRES_DB=voltius

# Base image for the Postgres + WAL-G build. Both work; the difference is the C
# library, and the C library decides how text sorts:
#
#   postgres:17-trixie   glibc   742 MB   10,2,a,A,b,B,eclair,éclair,_x,Zoe
#   postgres:17-alpine   musl    496 MB   10,2,A,B,Zoe,_x,a,b,eclair,éclair
#
# (same ORDER BY, two fresh clusters). initdb bakes that ordering into every text
# index, so switching this under an existing data directory silently leaves those
# indexes in the wrong order. Change it only across a dump and reload, and keep it
# equal to whatever your cluster was created with.
PG_BASE=postgres:17-trixie

# Where WAL-G writes base backups and archived WAL, e.g. s3://my-bucket/voltius-prod
WALG_S3_PREFIX=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AWS_REGION=auto

# Seconds between base backups, and how many to keep. The retention step also drops
# WAL below the oldest retained backup, which is why it is not left to a bucket
# lifecycle rule: an age-based rule can delete WAL a retained base still needs.
BASEBACKUP_INTERVAL=86400
BASEBACKUP_RETAIN=14

BACKUP_SCHEDULE=@daily
BACKUP_MIRROR_INTERVAL=86400
TZ=UTC

# Loopback-only admin port for psql and Studio.
DB_ADMIN_PORT=5433

# Optional Supabase Studio (profile "studio" — never started by default).
# The three values below are the upstream demo credentials from Supabase's
# self-hosting .env.example; Studio refuses to boot without them, and they grant
# nothing here because no PostgREST or GoTrue is exposed.
STUDIO_PORT=8000
STUDIO_ORG_NAME=Voltius
STUDIO_PROJECT_NAME=voltius-prod
PG_META_CRYPTO_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
STUDIO_JWT_SECRET=
